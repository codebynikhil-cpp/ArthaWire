# FinPulse — Real-Time X-Based Financial Intelligence Platform Configuration

# Official X API v2 Credentials
# Obtain from https://developer.x.com
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=

# Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./finpulse.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/finpulse

# Ingestion Settings
MAX_MONITORED_CREATORS=10
DEFAULT_POLL_INTERVAL_MINUTES=15
SIMULATION_MODE=true

# NLP & AI Settings
USE_FINBERT_TRANSFORMERS=true
FINBERT_MODEL_NAME=ProsusAI/finbert

